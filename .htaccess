<IfModule mod_headers.c>
  <FilesMatch "manifest\.json$">
    Header set Content-Type "application/manifest+json"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /rw/

  # Pass Authorization header through to PHP
  RewriteCond %{HTTP:Authorization} .+
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Block access to source and include files
  RewriteRule ^src/ - [F,L]
  RewriteRule ^node_modules/ - [F,L]
  RewriteRule ^includes/ - [F,L]

  # Don't rewrite backend or ochaka static assets
  RewriteRule ^backend/ - [L]
  RewriteRule ^ochaka/ - [L]

  # Don't rewrite existing real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URL routing for PHP pages
  RewriteRule ^shop/?$ shop.php [L,QSA]
  RewriteRule ^product/([^/]+)/?$ product.php?slug=$1 [L,QSA]
  RewriteRule ^category/([^/]+)/?$ category.php?slug=$1 [L,QSA]
  RewriteRule ^cart/?$ cart.php [L]
  RewriteRule ^checkout/?$ checkout.php [L]
  RewriteRule ^login/?$ login.php [L,QSA]
  RewriteRule ^register/?$ login.php?mode=register [L]
  RewriteRule ^account/?$ account.php [L,QSA]
  RewriteRule ^orders/?$ account.php?tab=orders [L]
  RewriteRule ^track-order/?$ track-order.php [L,QSA]
  RewriteRule ^faq/?$ faq.php [L]
  RewriteRule ^contact/?$ contact.php [L]
  RewriteRule ^blog/?$ blog.php [L]
  RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L,QSA]
</IfModule>
