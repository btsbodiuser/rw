<IfModule mod_headers.c>
  <FilesMatch "manifest\.json$">
    Header set Content-Type "application/manifest+json"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # On local WampServer (localhost), the app lives under /rw/
  # On the live server the app is at the document root — VBASE stays empty
  RewriteCond %{HTTP_HOST} ^localhost [NC]
  RewriteRule ^ - [E=VBASE:/rw]

  # Pass Authorization header through to PHP
  RewriteCond %{HTTP:Authorization} .+
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Block access to source and include files
  RewriteRule ^src/ - [F,L]
  RewriteRule ^node_modules/ - [F,L]
  RewriteRule ^includes/ - [F,L]

  # Don't rewrite backend or ochaka static assets
  RewriteRule ^backend/ - [L]
  RewriteRule ^ochaka/ - [L]

  # Don't rewrite existing real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URL routing
  # %{ENV:VBASE} = /rw on localhost, empty string on live server
  RewriteRule ^shop/?$                    %{ENV:VBASE}/shop.php [L,QSA]
  RewriteRule ^shop/([^/]+)/?$            %{ENV:VBASE}/shop.php?shop_slug=$1 [L,QSA]
  RewriteRule ^product/([^/]+)/?$         %{ENV:VBASE}/product.php?slug=$1 [L,QSA]
  RewriteRule ^category/([^/]+)/?$        %{ENV:VBASE}/category.php?slug=$1 [L,QSA]
  RewriteRule ^cart/?$                    %{ENV:VBASE}/cart.php [L]
  RewriteRule ^checkout/?$               %{ENV:VBASE}/checkout.php [L]
  RewriteRule ^login/?$                   %{ENV:VBASE}/login.php [L,QSA]
  RewriteRule ^register/?$               %{ENV:VBASE}/login.php?mode=register [L]
  RewriteRule ^account/?$                %{ENV:VBASE}/account.php [L,QSA]
  RewriteRule ^orders/?$                 %{ENV:VBASE}/account-orders.php [L]
  RewriteRule ^track-order/?$            %{ENV:VBASE}/track-order.php [L,QSA]
  RewriteRule ^faq/?$                    %{ENV:VBASE}/faq.php [L]
  RewriteRule ^contact/?$               %{ENV:VBASE}/contact.php [L]
  RewriteRule ^blog/?$                   %{ENV:VBASE}/blog.php [L]
  RewriteRule ^blog/([^/]+)/?$           %{ENV:VBASE}/blog-post.php?slug=$1 [L,QSA]
</IfModule>
